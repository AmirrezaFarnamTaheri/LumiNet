{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminet.invalid/provenance-ledger/schema-v1.json",
  "title": "LumiNet immutable provenance source record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_ref",
    "display_name",
    "source_kind",
    "immutable_locator",
    "content",
    "retrieved_at",
    "upstream",
    "license",
    "qualification"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_ref": {
      "type": "string",
      "pattern": "^source:[a-z0-9][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)*$"
    },
    "display_name": {"$ref": "#/$defs/nonEmptyString"},
    "source_kind": {
      "enum": ["repository-snapshot", "upstream-snapshot", "historical-artifact"]
    },
    "immutable_locator": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\].*"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "byte_size"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": ["resolved", "unavailable", "unresolved", "force-push-suspected"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40,64}$"
        },
        "evidence": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": ["identified", "present-unclassified", "unknown"]
        },
        "spdx_id": {"$ref": "#/$defs/nonEmptyString"},
        "evidence": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence"],
      "properties": {
        "state": {
          "enum": ["qualified", "unavailable", "unresolved", "contradictory"]
        },
        "evidence": {"$ref": "#/$defs/nonEmptyStringArray"},
        "contradiction_markers": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"},
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    }
  }
}
