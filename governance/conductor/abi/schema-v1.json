{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LumiCore ABI manifest",
  "type": "object",
  "required": ["schema_version", "abi", "envelope", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "abi": {
      "type": "object",
      "required": ["major", "minor", "patch"],
      "properties": {"major": {"const": 3}, "minor": {"type": "integer", "minimum": 0}, "patch": {"type": "integer", "minimum": 0}}
    },
    "envelope": {"type": "object", "required": ["request", "status", "ownership"]},
    "operations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "status"], "properties": {"status": {"enum": ["implemented", "declared_not_implemented", "deprecated"]}}}}
  }
}
